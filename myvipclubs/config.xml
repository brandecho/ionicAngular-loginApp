<?xml version='1.0' encoding='utf-8'?>
<widget id="com.myvipclubs.app" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>My VIP Clubs</name>
  <description>The hookup. Recognized before you walk in the door.</description>
  <author email="brandechomedia@gmail.com" href="https://myvipclubs.app">My VIP Clubs</author>

  <!-- Angular builds into ./www (see angular.json). -->
  <content src="index.html" />

  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <access origin="*" />

  <!-- ============ Global preferences ============ -->
  <preference name="DisallowOverscroll" value="true" />
  <preference name="BackgroundColor" value="0xff0a0a0f" />
  <preference name="SplashMaintainAspectRatio" value="true" />
  <preference name="StatusBarStyle" value="lightcontent" />

  <!-- ============ Pushwoosh ============ -->
  <!-- TODO: replace with your real values (also mirror in pushwoosh.config.ts). -->
  <preference name="PW_APPID" value="XXXXX-XXXXX" />
  <preference name="PW_PROJECT_ID" value="FIREBASE_SENDER_ID" />
  <preference name="PW_LOG_LEVEL" value="INFO" />

  <!-- ============ Android ============ -->
  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="android-compileSdkVersion" value="34" />
    <!-- Serve app content over https://localhost so ES modules + routing work. -->
    <preference name="Scheme" value="https" />
    <preference name="Hostname" value="localhost" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
    <preference name="GradlePluginGoogleServicesEnabled" value="true" />
    <preference name="GradlePluginGoogleServicesVersion" value="4.4.2" />

    <!-- Firebase config for Pushwoosh push on Android. -->
    <resource-file src="google-services.json" target="app/google-services.json" />

    <!-- Location permissions for geofencing. -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
      <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    </config-file>

    <icon density="ldpi" src="res/android/icon-36.png" />
    <icon density="mdpi" src="res/android/icon-48.png" />
    <icon density="hdpi" src="res/android/icon-72.png" />
    <icon density="xhdpi" src="res/android/icon-96.png" />
    <icon density="xxhdpi" src="res/android/icon-144.png" />
    <icon density="xxxhdpi" src="res/android/icon-192.png" />
  </platform>

  <!-- ============ iOS ============ -->
  <platform name="ios">
    <preference name="deployment-target" value="13.0" />
    <preference name="WKWebViewOnly" value="true" />
    <preference name="scheme" value="app" />
    <preference name="hostname" value="localhost" />

    <!-- Push (aps-environment) + background modes. -->
    <config-file target="*-Debug.plist" parent="aps-environment">
      <string>development</string>
    </config-file>
    <config-file target="*-Release.plist" parent="aps-environment">
      <string>production</string>
    </config-file>

    <!-- Location usage strings required for geofencing. -->
    <edit-config target="NSLocationWhenInUseUsageDescription" file="*-Info.plist" mode="merge">
      <string>My VIP Clubs uses your location to recognize you when you arrive at a venue.</string>
    </edit-config>
    <edit-config target="NSLocationAlwaysAndWhenInUseUsageDescription" file="*-Info.plist" mode="merge">
      <string>My VIP Clubs notifies venues you're approaching so they can welcome you — even in the background.</string>
    </edit-config>
    <edit-config target="NSLocationAlwaysUsageDescription" file="*-Info.plist" mode="merge">
      <string>My VIP Clubs notifies venues you're approaching so they can welcome you — even in the background.</string>
    </edit-config>
    <config-file target="*-Info.plist" parent="UIBackgroundModes">
      <array>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
      </array>
    </config-file>
  </platform>

  <!-- ============ Plugins ============ -->
  <plugin name="cordova-plugin-device" spec="^2.1.0" />
  <plugin name="cordova-plugin-geolocation" spec="^5.0.0">
    <variable name="GEOLOCATION_USAGE_DESCRIPTION"
              value="My VIP Clubs uses your location to recognize you when you arrive at a venue." />
  </plugin>
  <plugin name="pushwoosh-cordova-plugin" spec="^8.4.0" />
  <plugin name="cordova-plugin-geofence" spec="^0.6.0" />
  <plugin name="cordova-plugin-androidx-adapter" spec="^1.1.3" />

  <engine name="android" spec="^13.0.0" />
  <engine name="ios" spec="^7.1.1" />
</widget>
