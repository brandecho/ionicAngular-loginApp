# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=8080
# Comma-separated origins allowed to call the API (the app's URLs)
CORS_ORIGIN=https://app.myvipclubs.com,http://localhost:4200

# --- MySQL (your GoDaddy VPS database) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=myvipclubs
DB_PASSWORD=change-me
DB_NAME=myvipclubs

# --- Auth ---
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# --- Twilio (SMS). Leave blank to run without sending (logs to sms_outbox only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service SID (preferred) OR a From number
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- JotForm webhook shared secret (optional; adds a check to the webhook) ---
JOTFORM_WEBHOOK_TOKEN=
